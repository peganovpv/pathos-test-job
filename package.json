{
  "name": "press-release-quality-checker",
  "version": "0.1.0",
  "private": true,
  "description": "Scores a draft press release against a PR-specific rubric and returns actionable feedback.",
  "type": "module",
  "bin": {
    "prq": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && cp src/web/index.html dist/web/index.html",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsx src/cli.ts",
    "serve": "tsx src/web/server.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
