# One of these two. Unset both and every run needs --offline.

# Pay-as-you-go API key from console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-...

# Or a bearer token — an `ant auth login` access token, or a gateway token.
# When this is used without an API key, prq adds the anthropic-beta:
# oauth-2025-04-20 header the SDK omits for a bare env var.
# ANTHROPIC_AUTH_TOKEN=...

# Optional. Defaults to claude-sonnet-5.
# PRQ_MODEL=claude-opus-5

# Optional. Port for `npm run serve`. Defaults to 3000.
# PORT=3000
